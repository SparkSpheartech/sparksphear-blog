{
  "framework": "nextjs",
  "trailingSlash": false,
  "redirects": [
    { "source": "/p/what-does-the-sparksphear-team-resarch", "destination": "/p/what-does-the-sparksphear-team-about", "statusCode": 308 },
    { "source": "/archives", "destination": "/#categories", "statusCode": 308 }
  ],
  "rewrites": [
    { "source": "/api/newsletter", "destination": "https://odoo.sparkspheartechsolutions.com/website_mass_mailing/subscribe" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
